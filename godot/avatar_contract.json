{
  "version": "2.2.0",
  "engine": "godot-real-art",
  "license_model": "free-open-source",
  "renderer": "full-frame-expression-crossfade",
  "mouth_patch": false,
  "teachers": [
    "lily",
    "oliver",
    "sara",
    "sofia"
  ],
  "modes": [
    "idle",
    "listening",
    "thinking",
    "speaking"
  ],
  "emotions": [
    "neutral",
    "happy",
    "amused",
    "encouraging",
    "excited",
    "curious",
    "thinking",
    "confused",
    "surprised",
    "annoyed",
    "frustrated",
    "sarcastic",
    "disappointed",
    "sad",
    "serious",
    "proud"
  ],
  "visemes": [
    "REST",
    "A",
    "E",
    "I",
    "O",
    "U",
    "MBP",
    "FV",
    "L",
    "TH",
    "SZ",
    "SHCH"
  ],
  "commands": {
    "set_teacher": {
      "teacher": "lily|oliver|sara|sofia"
    },
    "set_mode": {
      "mode": "idle|listening|thinking|speaking"
    },
    "set_emotion": {
      "emotion": "enum",
      "strength": "0..1"
    },
    "set_viseme": {
      "viseme": "enum",
      "strength": "0..1"
    },
    "set_gaze": {
      "x": "-1..1",
      "y": "-1..1"
    },
    "set_head": {
      "x": "-1..1",
      "y": "-1..1"
    },
    "event": {
      "event": "blink|laugh|sigh|head_nod|look_side|look_up",
      "strength": "0..1"
    },
    "snapshot": {}
  },
  "web_bridge": {
    "function": "window._professoresGodotCommand(JSON.stringify(command))",
    "snapshot_event": "window.parent.postMessage({type:'professores-godot-snapshot', payload:'...'}, '*')"
  }
}
