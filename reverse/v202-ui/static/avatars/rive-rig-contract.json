{
  "version": 3,
  "state_machine": "AvatarStateMachine",
  "renderer_contract": "continuous parameters; no viseme sprite switching",
  "layers": [
    "BASE_POSE",
    "EMOTION_LAYER",
    "SPEECH_LAYER",
    "GAZE_LAYER",
    "BLINK_LAYER",
    "MICROEXPRESSION_LAYER",
    "BODY_LAYER"
  ],
  "inputs": {
    "eyeLeftX": "number -1..1",
    "eyeLeftY": "number -1..1",
    "eyeRightX": "number -1..1",
    "eyeRightY": "number -1..1",
    "eyeOpenLeft": "number 0..1",
    "eyeOpenRight": "number 0..1",
    "eyeSquintLeft": "number 0..1",
    "eyeSquintRight": "number 0..1",
    "blinkLeft": "number 0..1",
    "blinkRight": "number 0..1",
    "upperLidLeft": "number 0..1",
    "upperLidRight": "number 0..1",
    "lowerLidLeft": "number 0..1",
    "lowerLidRight": "number 0..1",
    "browLeftY": "number -1..1",
    "browRightY": "number -1..1",
    "browLeftAngle": "number -1..1",
    "browRightAngle": "number -1..1",
    "browInnerRaise": "number 0..1",
    "browFrown": "number 0..1",
    "jawOpen": "number 0..1",
    "mouthWidth": "number 0..1",
    "mouthRound": "number 0..1",
    "lipUpperRaise": "number 0..1",
    "lipLowerDrop": "number 0..1",
    "lipPress": "number 0..1",
    "lipCornerLeft": "number -1..1",
    "lipCornerRight": "number -1..1",
    "smile": "number 0..1",
    "frown": "number 0..1",
    "cheekRaiseLeft": "number 0..1",
    "cheekRaiseRight": "number 0..1",
    "cheekPuff": "number 0..1",
    "noseWrinkle": "number 0..1",
    "headYaw": "number -1..1",
    "headPitch": "number -1..1",
    "headRoll": "number -1..1",
    "neckFollow": "number -1..1",
    "chestBreath": "number 0..1",
    "shoulderLift": "number 0..1",
    "posture": "number -1..1",
    "bodyEnergy": "number 0..1"
  },
  "timed_speech": {
    "input": "phoneme timeline [{phoneme,start,end}]",
    "pipeline": "phoneme -> viseme target -> anticipatory coarticulation -> continuous rig parameters",
    "visemes": [
      "REST",
      "A",
      "E",
      "I",
      "O",
      "U",
      "MBP",
      "FV",
      "L",
      "TH",
      "SZ",
      "SHCH"
    ]
  },
  "note": "v1.7 current renderer is a local 2.5D continuous parametric DOM/SVG rig. The exact same channel contract is ready for a future native .riv mesh without changing ConversationEngine, EmotionEngine or PerformanceEngine."
}
