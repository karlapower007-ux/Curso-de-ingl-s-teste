{
  "feature": "citation_dictionary_v8_0_1",
  "authorization_scope": "explicit-user-request-desktop-and-mobile-citation-ui",
  "authorized_frontend_files": [
    "consciencia-fabiano/public/app.js",
    "consciencia-fabiano/public/style.css"
  ],
  "protected_frontend_files": [
    "consciencia-fabiano/public/index.html",
    "consciencia-fabiano/public/failover-v3.js",
    "consciencia-fabiano/public/sw-v3.js"
  ],
  "library": {
    "mutate_existing_chunks": false,
    "mutate_existing_vectors": false,
    "reindex_required": false,
    "migration_required": false
  },
  "citation_dictionary": {
    "page_size": 50,
    "scan_limit": 50000,
    "llm_independent": true,
    "desktop_mobile_parity": true,
    "technical_document_secondary": true,
    "ordinary_book_primary_fields": [
      "book",
      "chapter",
      "page"
    ],
    "scripture_primary_fields": [
      "work",
      "book",
      "chapter",
      "verse"
    ],
    "backend_preference": "r2-authoritative",
    "r2_full_scan_fallback": false,
    "r2_authoritative_snapshot_required": true,
    "segmented_r2_scan": true,
    "shards_per_request": 4,
    "cpu_bounded": true,
    "client_progressive_scan": true,
    "max_library_capacity": 50000,
    "strict_scripture_source_classification": true,
    "chapter_word_number_resolution": true,
    "segment_shards": 1,
    "concurrent_desktop_mobile_cpu_guard": true,
    "named_section_fallback": true,
    "scripture_segment_carry": true,
    "scripture_verse_range_inference": true,
    "strict_scripture_source_identity": true,
    "canonical_scripture_filename_suffixes": true,
    "known_production_standard_works_filename": "standard-works-83806-por.pdf",
    "false_positive_example_must_remain_book": "Doutrina e Convênios e o Futuro (Roy W. Doxey) sudbr.org.pdf",
    "scripture_direct_reference_parser_gate": false,
    "max_matches_per_segment": 500,
    "cpu_1102_hotfix": "one-shard-bounded-metadata-parsing",
    "regex_precompiled": true,
    "scripture_primary_location_is_not_cross_reference": true,
    "scripture_cross_references_separate": true,
    "standard_works_seed_book": "Gênesis",
    "precompiled_patterns": [
      "chapter-heading",
      "scripture-source",
      "scripture-reference",
      "scripture-heading"
    ],
    "heading_probe_chars": 900,
    "verse_probe_chars": 2400,
    "cross_references_deferred": true,
    "inline_chapter_headings": true,
    "inline_verse_markers": true,
    "multi_chapter_chunk_locations": true,
    "scripture_initial_chapter_seed": true,
    "footnote_aware_verse_markers": true,
    "book_inline_heading_guard": "strong-heading-case-only",
    "primary_scripture_location": [
      "work",
      "book",
      "chapter",
      "verse_start",
      "verse_end"
    ],
    "exact_request_only": true,
    "all_anchor_terms_required": true,
    "document_names_exposed": false,
    "chat_exact_request_only": true,
    "chat_document_names_exposed": false,
    "book_reference_required": [
      "book",
      "chapter",
      "page"
    ],
    "book_chapter_title_optional": true,
    "scripture_reference_required": [
      "book",
      "chapter",
      "verse"
    ],
    "standard_works_document_name_forbidden": true,
    "query_scope_examples": {
      "Adão": "somente trechos que contêm Adão",
      "Miguel": "somente trechos que contêm Miguel"
    }
  },
  "ci_retrigger": "v8-adaptive-acceptance-after-authorized-ui-gate"
}
