{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fns-stt",
  "main": "src/strict-output.js",
  "compatibility_date": "2026-09-15",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/health",
      "/stt",
      "/tts",
      "/chat"
    ]
  }
}
