; Professores IA — Godot Free Avatar Engine
config_version=5

[application]
config/name="Professores IA - Godot Avatar Engine"
run/main_scene="res://godot/main.tscn"

[display]
window/size/viewport_width=768
window/size/viewport_height=960
window/size/window_width_override=614
window/size/window_height_override=768
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
