; Professores IA — Godot Free Avatar Engine
; Godot 4.x project kept isolated on branch professores-ia-godot-free-v220.
config_version=5

[application]
config/name="Professores IA - Godot Avatar Engine"
run/main_scene="res://godot/main.tscn"

[display]
window/size/viewport_width=900
window/size/viewport_height=900
window/size/window_width_override=720
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]
mode_idle={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":49)]}
mode_listening={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":50)]}
mode_thinking={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":51)]}
mode_speaking={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":52)]}
emotion_happy={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":72)]}
emotion_encouraging={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":69)]}
emotion_surprised={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":83)]}
emotion_serious={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":82)]}
