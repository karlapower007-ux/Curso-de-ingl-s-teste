{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "consciencia-fabiano",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",
  "durable_objects": {
    "bindings": [
      {
        "name": "LIBRARY",
        "class_name": "LibraryDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "library-do-v1",
      "new_sqlite_classes": [
        "LibraryDO"
      ]
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/admin",
      "/health",
      "/api/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "PDFS",
      "bucket_name": "consciencia-fabiano-pdfs"
    }
  ],
  "vars": {
    "FNS_SECONDARY_URL": "https://bfctgmtidroczuwzhqkg.supabase.co/functions/v1/fns-resilience-secondary"
  }
}
